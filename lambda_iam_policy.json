{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadComputeAndMetrics",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeVolumes",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DiscoverBucketsAndListWorkloadObjects",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:ListBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WriteScanReportsOnlyToResultsBucket",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_RESULTS_BUCKET/scans/*"
    },
    {
      "Sid": "PublishCostGuardScanNotifications",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "REPLACE_WITH_SNS_TOPIC_ARN"
    }
  ]
}
